{
  "name": "desert-technology-handover-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:00": "remotion render src/index.ts WebsiteOverview out/00-website-overview-showcase.mp4",
    "render:01": "remotion render src/index.ts DashboardOverview out/01-dashboard-overview.mp4",
    "render:samples": "npm run render:00 && npm run render:01",
    "still:00": "remotion still src/index.ts WebsiteOverview out/00-preview.png --frame=600",
    "still:01": "remotion still src/index.ts DashboardOverview out/01-preview.png --frame=600"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.405",
    "@remotion/media": "^4.0.405",
    "@remotion/transitions": "^4.0.405",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remotion": "^4.0.405"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
