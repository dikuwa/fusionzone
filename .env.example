# ===========================================
# FusionZone — Environment
# ===========================================

# --- Database (isolated FusionZone Neon PostgreSQL) ---
# Get your connection string from Neon dashboard: https://console.neon.tech
# Example: postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/fusionzone?sslmode=require
# Leave EMPTY for dev mode (uses in-memory mock data, no auth required).
DATABASE_URL=
EXPECTED_DATABASE_NAME=fusionzone

# --- Better Auth (only needed in production) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Legacy technical variable names retained for compatibility. Values must be
# newly generated for FusionZone and must never be copied from another app.
# DESERTTECH_OWNER_PASSWORD=
# DESERTTECH_ADMIN_PASSWORD=
# DESERTTECH_STAFF_PASSWORD=

# --- Store Contact Info ---
NEXT_PUBLIC_STORE_WHATSAPP=264000000000
NEXT_PUBLIC_STORE_PHONE=+264000000000
NEXT_PUBLIC_STORE_EMAIL=info@fusionzone.example

# --- Resend (for transactional emails) ---
# Get your API key from: https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxx
#
# Sender email configuration:
#   RESEND_FROM_EMAIL — Must be a verified sender in your Resend account.
#     Use only a separately verified FusionZone sender domain.
#
#   RESEND_REPLY_TO_EMAIL — Where customer replies go.
#     Defaults to BUSINESS_EMAIL if not set.
#
#   BUSINESS_EMAIL — Fallback if RESEND_FROM_EMAIL is not set.
#
# Example:
#   RESEND_FROM_EMAIL=onboarding@resend.dev
#   RESEND_REPLY_TO_EMAIL=sales@fusionzone.example
#   BUSINESS_EMAIL=sales@fusionzone.example
# RESEND_FROM_EMAIL=
# RESEND_REPLY_TO_EMAIL=
# BUSINESS_EMAIL=

# --- Public App URL (for email links, shared documents) ---
# Leave empty in Vercel Preview so the deployment URL is resolved dynamically.
# In local development the application defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL=
DOCUMENT_SHARE_SECRET=

# --- Upstash Redis (for Better Auth session caching) ---
# Optional: improves performance by caching sessions
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Cloudflare R2 (product images and generated documents) ---
# CLOUDFLARE_R2_ENDPOINT=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=
# CLOUDFLARE_R2_PUBLIC_DEV_URL=

# Preferred aliases used by the storage abstraction:
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# --- Optional integrations ---
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_BUSINESS_PHONE=
# WHATSAPP_PHONE_NUMBER_ID=
# UPSTASH_REDIS_URL=
# UPSTASH_REDIS_TOKEN=
